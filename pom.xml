<?xml version="1.0" encoding="UTF-8"?>
<!--
  Parent build for shopizer-modern-java21.

  This repository previously contained only docs/infra placeholders; this POM establishes
  a concrete multi-module Maven baseline for Java 21 + Spring Boot 3.x + Spring Cloud.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.shopizer</groupId>
  <artifactId>shopizer-modern-java21</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>shopizer-modern-java21 (parent)</name>
  <description>Multi-module baseline for Shopizer modernization (Java 21, Spring Boot 3.x)</description>

  <modules>
    <module>gateway</module>
    <module>customer-service</module>
    <module>catalog-service</module>
    <module>cart-service</module>
    <module>order-service</module>
    <module>checkout-service</module>
    <module>payment-service</module>
    <module>shipping-service</module>
    <module>inventory-service</module>
    <module>pricing-service</module>
  </modules>

  <properties>
    <java.version>21</java.version>

    <!-- Spring Boot 3.x line -->
    <spring-boot.version>3.3.2</spring-boot.version>

    <!-- Spring Cloud 2023.x line compatible with Spring Boot 3.2/3.3 -->
    <spring-cloud.version>2023.0.3</spring-cloud.version>

    <maven.compiler.release>${java.version}</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-dependencies</artifactId>
        <version>${spring-boot.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>

      <dependency>
        <groupId>org.springframework.cloud</groupId>
        <artifactId>spring-cloud-dependencies</artifactId>
        <version>${spring-cloud.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.springframework.boot</groupId>
          <artifactId>spring-boot-maven-plugin</artifactId>
          <version>${spring-boot.version}</version>
        </plugin>

        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>3.13.0</version>
          <configuration>
            <release>${maven.compiler.release}</release>
          </configuration>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>

</project>
