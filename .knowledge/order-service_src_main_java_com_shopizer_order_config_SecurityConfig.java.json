", "format-version": 4, "code-base-name": "shopizer-modern-java21", "filename": "order-service/src/main/java/com/shopizer/order/config/SecurityConfig.java", "revision_history": [{"194": "ce9569614281606eb56e65d0aed0999c54fa2902"}]}